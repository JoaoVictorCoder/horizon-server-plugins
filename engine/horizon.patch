+    /// `PlayerJoinEvent` as a guest is placed: what everyone is told.
+    pub(super) fn plugins_joined(&mut self, host: &mut super::lan::LanHost, conn: u32) {
+        let Some(plugins) = self::host() else {
+            return;
+        };
+        let Some(player) = Self::plugins_guest(&host.hub, conn) else {
+            return;
+        };
+        let vanilla = format!("§e{} joined the game", player.name);
+        let said = plugins.player_joined(&mut GameBackend { game: self }, &player, &vanilla);
+        let line = match said {
+            None => return,
+            Some(s) if s == vanilla => {
