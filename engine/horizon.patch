+    /// What a guest's plugin command completes to: the start (a byte offset
+    /// in `command`) and the words; None for a command no plugin has.
+    pub(super) fn plugins_suggestions(
+        &mut self,
+        host: &horizon_client::lan::hub::Hub,
+        conn: u32,
+        command: &str,
+    ) -> Option<(usize, Vec<String>)> {
+        let plugins = self::host()?;
