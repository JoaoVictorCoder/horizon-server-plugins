+    fn plugins_menu_event(&mut self, uuid: u128, event: &str, data: impl FnOnce(Value) -> Value) {
+        let Some(host) = host() else {
+            return;
+        };
+        if !host.listens(event) {
+            return;
+        }
+        let mut backend = GameBackend { game: self };
+        let Some(player) = backend.players().into_iter().find(|p| p.uuid.0 == uuid) else {
+            return;
+        };
+        host.fire(
+            &mut backend,
+            event,
+            data(Value::map().with("player", player.to_wire())),
+        );
+    }
