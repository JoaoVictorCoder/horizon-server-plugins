+/// A level's own rules, reaching plugins (`GameLevel` holds no `Game`).
+pub(super) fn plugins_block_spread(
+    dimension: LevelDimension,
+    kind: &str,
+    from: GamePos,
+    to: GamePos,
+) -> bool {
+    let Some(host) = host() else {
+        return false;
+    };
+    let world = world_of(dimension);
+    let (event, data) = if kind == "fluid" {
+        (
+            "block_from_to",
+            Value::map()
+                .with("block", game_pos(world, from).to_wire())
+                .with("to", game_pos(world, to).to_wire()),
+        )
+    } else {
+        (
+            "block_spread",
+            Value::map()
+                .with("source", game_pos(world, from).to_wire())
+                .with("block", game_pos(world, to).to_wire()),
+        )
+    };
+    if !host.listens(event) {
+        return false;
+    }
+    host.fire(&mut Detached, event, data).1
+}
