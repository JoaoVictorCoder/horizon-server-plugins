+    /// `PlayerInteractEvent` for a left click, as a guest starts digging:
+    /// whether a plugin cancelled it (nothing is dug).
+    pub(super) fn plugins_left_click(
+        &mut self,
+        host: &horizon_client::lan::hub::Hub,
+        conn: u32,
+        pos: [i32; 3],
+        face: [i32; 3],
+    ) -> bool {
+        let Some(plugins) = self::host() else {
+            return false;
+        };
+        if !plugins.listens("player_interact") {
+            return false;
+        }
+        let Some(player) = Self::plugins_guest(host, conn) else {
+            return false;
+        };
+        let item = host
+            .guest(conn)
+            .and_then(|g| g.inventory.get(g.selected).cloned().flatten())
+            .map(|s| stack_of(&s));
+        let world = player.location.world.clone();
+        let block = Block {
+            pos: pos_of(&world, pos),
+            kind: if world == self.dim.id() {
+                self.native_block(pos)
+            } else {
+                String::new()
+            },
+            properties: if world == self.dim.id() {
+                self.plugins_state_properties(self.world.block(pos[0], pos[1], pos[2]))
+            } else {
+                Vec::new()
+            },
+        };
+        let data = Value::map()
+            .with("player", player.to_wire())
+            .with("action", "left_click_block")
+            .with("block", block.to_wire())
+            .with("face", BlockFace::from_offset(face).to_wire())
+            .with("item", item.to_wire());
+        plugins
+            .fire(&mut GameBackend { game: self }, "player_interact", data)
+            .1
+    }
