+pub(super) fn plugins_piston_move(
+    dimension: LevelDimension,
+    piston: GamePos,
+    direction: [i32; 3],
+    push: &[GamePos],
+    destroy: &[GamePos],
+) -> bool {
+    let Some(host) = host() else {
+        return false;
+    };
+    if !host.listens("block_piston") {
+        return false;
+    }
+    let world = world_of(dimension);
+    let list = |l: &[GamePos]| {
+        l.iter()
+            .map(|p| game_pos(world, *p))
+            .collect::<Vec<_>>()
+            .to_wire()
+    };
+    let data = Value::map()
+        .with("piston", game_pos(world, piston).to_wire())
+        .with(
+            "direction",
+            BlockFace::from_offset(direction)
+                .unwrap_or_default()
+                .to_wire(),
+        )
+        .with("blocks", list(push))
+        .with("destroyed", list(destroy));
+    host.fire(&mut Detached, "block_piston", data).1
+}
