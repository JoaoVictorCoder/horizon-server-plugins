+                Text::translate("multiplayer.player.joined", &[who])
+                    .with_color(horizon_client::text::YELLOW)
+            }
+            Some(s) => Text::legacy(&s),
+        };
+        host.hub.system_message(component_nbt(&line.component()));
+    }
