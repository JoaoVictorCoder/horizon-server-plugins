+/// The components that change how the client draws and describes a stack,
+/// as `/give` or a plugin set them: the model a resource pack gives it, its
+/// lore, rarity, glint, stack size and custom data.
+fn drawn_components(d: &crate::item_data::StackData, stack: &mut Stack) {
+    use horizon_protocol::item::{Component, component};
+    use horizon_world::nbt::Tag;
+    if let Some(Tag::String(model)) = d.other("minecraft:item_model") {
+        stack.added.push((
+            component::ITEM_MODEL,
+            Component::Ident(model.to_string_lossy()),
+        ));
+    }
+    if let Some(Tag::List(lines)) = d.other("minecraft:lore") {
+        let lines: Vec<Tag> = lines.iter().take(256).cloned().collect();
+        stack.added.push((component::LORE, Component::Lore(lines)));
+    }
+    if let Some(Tag::String(rarity)) = d.other("minecraft:rarity") {
+        let id = ["common", "uncommon", "rare", "epic"]
+            .iter()
+            .position(|r| *r == rarity.to_string_lossy());
+        if let Some(id) = id {
+            stack
+                .added
+                .push((component::RARITY, Component::Int(id as i32)));
+        }
+    }
+    let int = |t: &Tag| match t {
+        Tag::Byte(v) => Some(i32::from(*v)),
+        Tag::Short(v) => Some(i32::from(*v)),
+        Tag::Int(v) => Some(*v),
+        _ => None,
+    };
+    if let Some(n) = d.other("minecraft:max_stack_size").and_then(int)
+        && (1..=99).contains(&n)
+    {
+        stack
+            .added
+            .push((component::MAX_STACK_SIZE, Component::Int(n)));
+    }
+    if let Some(glint) = d
+        .other("minecraft:enchantment_glint_override")
+        .and_then(int)
+    {
+        stack.added.push((
+            component::ENCHANTMENT_GLINT_OVERRIDE,
+            Component::Bool(glint != 0),
+        ));
+    }
+    if let Some(data @ Tag::Compound(_)) = d.other("minecraft:custom_data") {
+        stack
+            .added
+            .push((component::CUSTOM_DATA, Component::Nbt(data.clone())));
+    }
+}
