+
+impl Game<'_> {
+    /// Fires `event` from a player's action: whether a plugin cancelled it.
+    fn plugins_fire(
+        &mut self,
+        event: &str,
+        data: impl FnOnce(&Self, Value) -> Value,
+    ) -> (Value, bool) {
+        let Some(host) = host() else {
+            return (Value::Null, false);
+        };
+        if !host.listens(event) {
+            return (Value::Null, false);
+        }
+        let Some(player) = self.native_acting_player() else {
+            return (Value::Null, false);
+        };
+        let base = Value::map().with("player", player_of(&player).to_wire());
+        let data = data(self, base);
+        host.fire(&mut GameBackend { game: self }, event, data)
+    }
+
+    /// The acting player's world.
+    fn plugins_world(&self) -> &'static str {
+        self.dim.id()
+    }
+
+    /// Loads and enables `plugins/` on a dedicated server whose world is
+    /// ready, before its first tick (so their commands are in the tree).
+    pub(super) fn plugins_start(&mut self) {
+        if self.options.dedicated.is_none() || host().is_some() {
+            return;
+        }
+        let dir = std::env::current_dir().unwrap_or_default().join("plugins");
+        if let Err(e) = std::fs::create_dir_all(&dir) {
+            super::dedicated::log("WARN", &format!("[Plugins] {}: {e}", dir.display()));
+        }
+        let host = PluginHost::new(&dir);
+        PLUGINS.with(|p| *p.borrow_mut() = Some(host.clone()));
+        let mut backend = GameBackend { game: self };
+        // Fills the players' cache too.
+        let _ = backend.players();
+        host.load_all(&mut backend);
+        host.enable(&mut backend, None);
+        host.fire(&mut backend, "world_load", Value::map());
+        if let Some(lan) = self.lan.as_mut() {
+            lan.hub.plugin_chat = host.listens("player_chat");
+        }
+        let n = host.plugins().len();
+        if n > 0 {
+            super::dedicated::log("INFO", &format!("[Plugins] {n} plugin(s) enabled"));
+        }
+    }
+
+    /// Disables every plugin as the server stops, before the players are
+    /// saved and kicked.
+    pub(super) fn plugins_stop(&mut self) {
+        let Some(host) = host() else {
+            return;
+        };
+        let mut backend = GameBackend { game: self };
+        host.fire(&mut backend, "world_unload", Value::map());
+        host.disable_all(&mut backend);
+        PLUGINS.with(|p| *p.borrow_mut() = None);
+    }
+
+    /// The server tick's start (`true`) or end, inside the tick hook's read
+    /// scope: what waited for it, the schedulers, the tick events, the
+    /// players' changes, and chat.
+    pub(super) fn plugins_tick(&mut self, context: &NativeLifecycleContext, start: bool) {
+        let Some(host) = host() else {
+            return;
+        };
+        let tick = STATE.with(|s| {
+            let mut s = s.borrow_mut();
+            s.context = Some(*context);
+            if start {
+                s.tick += 1;
+            }
+            s.tick
+        });
+        if start {
+            let (tells, broadcasts) = STATE.with(|s| {
+                let mut s = s.borrow_mut();
+                (
+                    std::mem::take(&mut s.tells),
+                    std::mem::take(&mut s.broadcasts),
+                )
+            });
+            for (uuid, line) in tells {
+                self.native_tell(uuid.0, Text::legacy(&line));
+            }
+            for line in broadcasts {
+                self.native_broadcast(Text::legacy(&line));
+            }
+            if host.take_reload_request() {
+                host.reload(&mut GameBackend { game: self });
+                // The players' command tree is built again at the next
+                // tick, with the plugins' commands as they are now.
+                if let Some(lan) = self.lan.as_mut() {
+                    lan.native_commands = None;
+                }
+            }
+            host.tick_start(&mut GameBackend { game: self }, tick);
+        } else {
+            self.plugins_chat(&host);
+            host.tick_end(&mut GameBackend { game: self }, tick);
+        }
+        if let Some(lan) = self.lan.as_mut() {
+            lan.hub.plugin_chat = host.listens("player_chat");
+            lan.hub.plugin_join_messages = true;
+        }
+        STATE.with(|s| s.borrow_mut().context = None);
+    }
+
+    /// A chat message the hub held back for plugins: their verdict, at the
+    /// tick's end. Unchanged, it goes out as vanilla sends it (signed);
+    /// reformatted, as a system line to everyone.
+    pub(super) fn plugins_hold_chat(&mut self, chat: PluginChat) {
+        STATE.with(|s| s.borrow_mut().chats.push(chat));
+    }
+
+    fn plugins_chat(&mut self, host: &PluginHost) {
+        let chats = STATE.with(|s| std::mem::take(&mut s.borrow_mut().chats));
+        for chat in chats {
+            let player = self
+                .native_server_players()
+                .into_iter()
+                .find(|p| p.uuid == chat.sender);
+            let Some(player) = player else {
+                continue;
+            };
+            let data = Value::map()
+                .with("player", player_of(&player).to_wire())
+                .with("message", &chat.message.content)
+                .with("format", CHAT_FORMAT);
+            let (out, cancelled) = host.fire(&mut GameBackend { game: self }, "player_chat", data);
+            if cancelled {
+                continue;
+            }
+            let text = |k: &str, or: &str| {
+                out.get(k)
+                    .and_then(Value::to_text)
+                    .unwrap_or_else(|| or.to_owned())
+            };
+            let message = text("message", &chat.message.content);
+            let format = text("format", CHAT_FORMAT);
+            if message == chat.message.content && format == CHAT_FORMAT {
+                let mut events = Vec::new();
+                if let Some(lan) = self.lan.as_mut() {
+                    let line = format!("<{}> {}", chat.name, chat.message.content);
+                    lan.hub
+                        .broadcast_chat(&chat.message, &chat.bound, line, &mut events);
+                }
+                for e in events {
+                    self.lan_log_event(e);
+                }
+            } else {
+                let line = format.replace("%1$s", &chat.name).replace("%2$s", &message);
+                self.native_broadcast(Text::legacy(&line));
+            }
+        }
+    }
+
+    /// The commands plugins added, for every player's command tree: each
+    /// takes the rest of the line, which the plugin splits.
+    pub(super) fn plugins_commands(commands: &mut Vec<NativeCommand>) {
+        let Some(host) = host() else {
+            return;
+        };
+        for name in host.command_names() {
+            commands.push(NativeCommand::new(&format!("{name} [args:suggested]")));
+        }
+    }
+
+    /// A player's command (no slash) for a plugin: whether it was one.
+    pub(super) fn plugins_perform_command(
+        &mut self,
+        player: &NativeServerPlayer,
+        line: &str,
+    ) -> bool {
+        let Some(host) = host() else {
+            return false;
+        };
+        let sender = CommandSender::Player(player_of(player));
+        host.command(&mut GameBackend { game: self }, sender, line)
+    }
+
+    /// A console line for a plugin: whether it was one.
+    pub(super) fn plugins_console_command(&mut self, line: &str) -> bool {
+        let Some(host) = host() else {
+            return false;
+        };
+        host.command(
+            &mut GameBackend { game: self },
+            CommandSender::Console,
+            line,
+        )
+    }
+
+    /// `BlockBreakEvent`: whether a plugin cancelled the break.
+    pub(super) fn plugins_destroy_block(&mut self, pos: [i32; 3], state: BlockStateId) -> bool {
+        let world = self.plugins_world();
+        let kind = self.res.facts().get(state).name.to_string();
+        let properties = self.plugins_state_properties(state);
+        let (_, cancelled) = self.plugins_fire("block_break", |_, d| {
+            d.with(
+                "block",
+                Block {
+                    pos: pos_of(world, pos),
+                    kind,
+                    properties,
+                }
+                .to_wire(),
+            )
+        });
+        cancelled
+    }
+
+    /// A block state's properties (`facing` → `north`), for plugins: custom
+    /// blocks drawn as note block states are told apart by them.
+    fn plugins_state_properties(&self, state: BlockStateId) -> Vec<(String, String)> {
+        self.pack
+            .assets
+            .registry
+            .state(state)
+            .map(|s| {
+                s.properties
+                    .iter()
+                    .map(|(k, v)| (k.clone(), v.clone()))
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+
+    /// A packet to one player, the acting one too (whose packets wait in
+    /// `guest_packets`): false when they aren't on.
+    fn plugins_send_to(&mut self, uuid: u128, packet: C) -> bool {
+        if self.lan_acting_uuid == Some(uuid) {
+            self.guest_packets.push(packet);
+            return true;
+        }
+        let Some(host) = &self.lan else {
+            return false;
+        };
+        let Some(g) = host.hub.guests.iter().find(|g| g.placed && g.uuid == uuid) else {
+            return false;
+        };
+        host.hub.send_to(g.conn, &packet);
+        true
+    }
+
+    /// `PlayerInteractEvent` on a block, before the block's own use.
+    pub(super) fn plugins_right_click_block(&mut self, pos: [i32; 3], face: [i32; 3]) -> bool {
+        let world = self.plugins_world();
+        let (_, cancelled) = self.plugins_fire("player_interact", |g, d| {
+            let item = g
+                .inventory
+                .get(g.selected)
+                .and_then(Option::as_ref)
+                .map(stack_of);
+            d.with("action", "right_click_block")
+                .with(
+                    "block",
+                    Block {
+                        pos: pos_of(world, pos),
+                        kind: g.native_block(pos),
+                        properties: g
+                            .plugins_state_properties(g.world.block(pos[0], pos[1], pos[2])),
+                    }
+                    .to_wire(),
+                )
+                .with("face", BlockFace::from_offset(face).to_wire())
+                .with("item", item.to_wire())
+        });
+        cancelled
+    }
+
+    /// `BlockPlaceEvent`, for an item that places a block, before it is
+    /// used on the block: whether a plugin cancelled the placement.
+    pub(super) fn plugins_use_item_on(
+        &mut self,
+        stack: &GameStack,
+        pos: [i32; 3],
+        face: [i32; 3],
+    ) -> bool {
+        if !self
+            .res
+            .items()
+            .get(&stack.item)
+            .is_some_and(|i| i.block.is_some())
+        {
+            return false;
+        }
+        let world = self.plugins_world();
+        let against = pos_of(world, pos);
+        let at = against.offset(face[0], face[1], face[2]);
+        let item = stack_of(stack);
+        let (_, cancelled) = self.plugins_fire("block_place", |_, d| {
+            d.with("block", at.to_wire())
+                .with("against", against.to_wire())
+                .with(
+                    "face",
+                    BlockFace::from_offset(face).unwrap_or_default().to_wire(),
+                )
+                .with("item", item.to_wire())
+        });
+        cancelled
+    }
+
+    /// `PlayerInteractEvent` in the air: the held item's own use.
+    pub(super) fn plugins_use_item(&mut self, stack: &GameStack) -> bool {
+        let item = stack_of(stack);
+        let (_, cancelled) = self.plugins_fire("player_interact", |_, d| {
+            d.with("action", "right_click_air")
+                .with("item", item.to_wire())
+        });
+        cancelled
+    }
+
+    /// `PlayerBucketFillEvent` (an empty bucket) or `PlayerBucketEmptyEvent`.
+    pub(super) fn plugins_fill_bucket(&mut self, stack: &GameStack, pos: [i32; 3]) -> bool {
+        let event = if &*stack.item == "minecraft:bucket" {
+            "player_bucket_fill"
+        } else {
+            "player_bucket_empty"
+        };
+        let world = self.plugins_world();
+        let bucket = stack_of(stack);
+        let (_, cancelled) = self.plugins_fire(event, |_, d| {
+            d.with("block", pos_of(world, pos).to_wire())
+                .with("bucket", bucket.to_wire())
+        });
+        cancelled
+    }
+
+    /// `PrePlayerAttackEntityEvent`.
+    pub(super) fn plugins_attack_entity(&mut self, id: i32, kind: &str, at: [f64; 3]) -> bool {
+        let world = self.plugins_world();
+        let entity = Entity {
+            id,
+            kind: kind.to_owned(),
+            location: Location::new(world, at[0], at[1], at[2]),
+        };
+        let (_, cancelled) = self.plugins_fire("player_attack_entity", |_, d| {
+            d.with("entity", entity.to_wire())
+        });
+        cancelled
+    }
+
+    /// `EntityExplodeEvent`: plugins take out the blocks to spare.
+    pub(super) fn plugins_explosion(
+        &mut self,
+        dimension: &str,
+        center: [f64; 3],
+        blocks: &mut Vec<[i32; 3]>,
+    ) {
+        let Some(host) = host() else {
+            return;
+        };
+        if !host.listens("entity_explode") {
+            return;
+        }
+        let list: Vec<BlockPos> = blocks.iter().map(|b| pos_of(dimension, *b)).collect();
+        let data = Value::map()
+            .with(
+                "location",
+                Location::new(dimension, center[0], center[1], center[2]).to_wire(),
+            )
+            .with("blocks", list.to_wire());
+        let (out, cancelled) = host.fire(&mut GameBackend { game: self }, "entity_explode", data);
+        if cancelled {
+            blocks.clear();
+            return;
+        }
+        if let Some(kept) = out.get("blocks").and_then(Vec::<BlockPos>::from_wire) {
+            blocks.retain(|b| kept.iter().any(|k| [k.x, k.y, k.z] == *b));
+        }
+    }
