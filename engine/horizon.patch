diff --git a/crates/horizon-client/src/game/plugins.rs b/crates/horizon-client/src/game/plugins.rs
new file mode 100644
index 0000000..65be094
--- /dev/null
+++ b/crates/horizon-client/src/game/plugins.rs
@@ -0,0 +1,1104 @@
+//! Server plugins (docs/plugins.md): a dedicated server loads the plugin
+//! libraries in `plugins/` with `horizon-plugin-host` when its world is
+//! ready, and hands them what the native hook points hear, at the same
+//! places: breaking and placing blocks, right clicks, buckets, attacks,
+//! explosions, fluids and fire, pistons, plugin menus, chat, commands and
+//! the server tick. Single player and LAN worlds load no plugins.
+//!
+//! Inside a player's action the game holds that player's state, and the
+//! other players can be out of reach (`self.lan` is taken): lines for them
+//! wait for the next tick here, and console commands in the host.
+
+use super::{
+    Dim, Game, LevelDimension,
+    native_lifecycle::NativeLifecycleContext,
+    native_server::{NativeCommand, NativeServerPlayer},
+};
+use horizon_client::{
+    items::ItemStack as GameStack,
+    lan::{data::component_nbt, hub::PluginChat},
+    text::Text,
+};
+use horizon_core::position::BlockPos as GamePos;
+use horizon_plugin_api::Value;
+use horizon_plugin_api::types::{
+    Block, BlockFace, BlockPos, CommandSender, Entity, GameMode, ItemStack, Location, Menu, Player,
+    ResourcePack, Uuid, Wire, worlds,
+};
+use horizon_plugin_host::{Backend, PluginHost};
+use horizon_protocol::packets::play::{self, Clientbound as C};
+use horizon_world::registry::BlockStateId;
+use std::cell::RefCell;
+
+/// Chat's format before plugins change it: `<name> message`.
+const CHAT_FORMAT: &str = "<%1$s> %2$s";
+
+#[derive(Default)]
+struct State {
+    /// The players as of the last time the hub was at hand.
+    players: Vec<Player>,
+    /// Lines for players out of reach, sent at the next tick.
+    tells: Vec<(Uuid, String)>,
+    broadcasts: Vec<String>,
+    /// Chat the hub held back for plugins (`Hub::plugin_chat`).
+    chats: Vec<PluginChat>,
+    /// The tick's context while plugins run in it, to read blocks.
+    context: Option<NativeLifecycleContext>,
+    tick: i64,
+}
+
+thread_local! {
+    /// The server thread's plugins; None outside a dedicated server.
+    static PLUGINS: RefCell<Option<PluginHost>> = const { RefCell::new(None) };
+    static STATE: RefCell<State> = RefCell::new(State::default());
+}
+
+fn host() -> Option<PluginHost> {
+    PLUGINS.with(|p| p.borrow().clone())
+}
+
+fn player_of(p: &NativeServerPlayer) -> Player {
+    Player {
+        uuid: Uuid(p.uuid),
+        name: p.name.clone(),
+        location: Location::new(&p.dimension, p.position[0], p.position[1], p.position[2]),
+        game_mode: GameMode::from_id(p.game_mode),
+        health: p.health,
+        op_level: p.permission,
+    }
+}
+
+fn stack_of(s: &GameStack) -> ItemStack {
+    use horizon_world::nbt::Tag;
+    let extra = s.extra.as_deref();
+    let model = match extra.and_then(|e| e.other("minecraft:item_model")) {
+        Some(Tag::String(m)) => Some(m.to_string_lossy()),
+        _ => None,
+    };
+    // The custom data's text tags (`forja:id`), as plugins set them.
+    let data = match extra.and_then(|e| e.other("minecraft:custom_data")) {
+        Some(Tag::Compound(c)) => c
+            .iter()
+            .filter_map(|(k, v)| match v {
+                Tag::String(v) => Some((k.to_string_lossy(), v.to_string_lossy())),
+                _ => None,
+            })
+            .collect(),
+        _ => Vec::new(),
+    };
+    ItemStack {
+        kind: s.item.to_string(),
+        amount: s.count,
+        name: extra.and_then(|e| e.custom_name_plain()),
+        lore: Vec::new(),
+        model,
+        data,
+        components: Vec::new(),
+    }
+}
+
+/// A plugin's stack as the game's: its name and lore as text components.
+fn game_stack(i: &ItemStack) -> GameStack {
+    let mut data = horizon_client::item_data::StackData::default();
+    if let Some(name) = &i.name {
+        data.custom_name = Some(component_nbt(&Text::legacy(name).component()));
+    }
+    if !i.lore.is_empty() {
+        let lines = i
+            .lore
+            .iter()
+            .map(|l| component_nbt(&Text::legacy(l).component()))
+            .collect();
+        data.other.push((
+            "minecraft:lore".to_owned(),
+            horizon_world::nbt::Tag::List(lines),
+        ));
+    }
+    if let Some(m) = &i.model {
+        data.other.push((
+            "minecraft:item_model".to_owned(),
+            horizon_world::nbt::Tag::String(m.as_str().into()),
+        ));
+    }
+    if !i.data.is_empty() {
+        let tags = i
+            .data
+            .iter()
+            .map(|(k, v)| {
+                (
+                    k.as_str().into(),
+                    horizon_world::nbt::Tag::String(v.as_str().into()),
+                )
+            })
+            .collect();
+        data.other.push((
+            "minecraft:custom_data".to_owned(),
+            horizon_world::nbt::Tag::Compound(tags),
+        ));
+    }
+    for (id, value) in &i.components {
+        match horizon_world::nbt::parse_snbt(value) {
+            Ok((tag, _)) => data
+                .other
+                .push((horizon_plugin_api::types::namespaced(id), tag)),
+            Err(e) => {
+                super::dedicated::log("WARN", &format!("[plugins] component {id}={value}: {e}"))
+            }
+        }
+    }
+    // StackData keeps the other components in key order.
+    data.other.sort_by(|a, b| a.0.cmp(&b.0));
+    let plain = i.is_plain();
+    GameStack {
+        item: horizon_plugin_api::types::namespaced(&i.kind).into(),
+        count: i.amount.clamp(1, 99),
+        damage: 0,
+        extra: (!plain).then(|| Box::new(data)),
+    }
+}
+
+fn world_of(d: LevelDimension) -> &'static str {
+    match d {
+        LevelDimension::Overworld => worlds::OVERWORLD,
+        LevelDimension::Nether => worlds::NETHER,
+        LevelDimension::End => worlds::END,
+    }
+}
+
+fn pos_of(world: &str, p: [i32; 3]) -> BlockPos {
+    BlockPos::new(world, p[0], p[1], p[2])
+}
+
+fn game_pos(world: &str, p: GamePos) -> BlockPos {
+    BlockPos::new(world, p.x, p.y, p.z)
+}
+
+fn system_chat(text: &Text) -> C {
+    C::SystemChat(play::SystemChat {
+        content: component_nbt(&text.component()),
+        overlay: false,
+    })
+}
+
+/// The game, as plugins reach it.
+struct GameBackend<'a, 'g> {
+    game: &'a mut Game<'g>,
+}
+
+impl Backend for GameBackend<'_, '_> {
+    fn players(&self) -> Vec<Player> {
+        if let Some(lan) = &self.game.lan {
+            let now: Vec<Player> = self
+                .game
+                .native_server_players()
+                .iter()
+                .map(|n| {
+                    let mut p = player_of(n);
+                    if let Some(g) = lan.hub.guests.iter().find(|g| g.uuid == n.uuid) {
+                        p.location = p.location.with_rotation(g.yaw, g.pitch);
+                    }
+                    p
+                })
+                .collect();
+            STATE.with(|s| s.borrow_mut().players = now.clone());
+            return now;
+        }
+        let mut players = STATE.with(|s| s.borrow().players.clone());
+        if let Some(acting) = self.acting_player()
+            && let Some(p) = players.iter_mut().find(|p| p.uuid == acting.uuid)
+        {
+            *p = acting;
+        }
+        players
+    }
+    fn acting_player(&self) -> Option<Player> {
+        let mut p = player_of(&self.game.native_acting_player()?);
+        p.location = p.location.with_rotation(self.game.yaw, self.game.pitch);
+        Some(p)
+    }
+    fn block_exists(&self, id: &str) -> Option<bool> {
+        Some(self.game.pack.assets.registry.default_state(id).is_some())
+    }
+    fn entities(&self, world: &str, kind: Option<&str>) -> Vec<Entity> {
+        if world != self.game.dim.id() {
+            return Vec::new();
+        }
+        self.game
+            .mobs
+            .iter()
+            .filter(|m| m.alive() && kind.is_none_or(|k| k == m.kind.id))
+            .map(|m| Entity {
+                id: m.id as i32,
+                kind: m.kind.id.to_string(),
+                location: Location::new(world, m.position.x, m.position.y, m.position.z)
+                    .with_rotation(m.yaw, 0.0),
+            })
+            .collect()
+    }
+    fn tell(&mut self, uuid: Uuid, message: &str) -> bool {
+        let text = Text::legacy(message);
+        if self.game.lan_acting_uuid == Some(uuid.0) {
+            self.game.guest_packets.push(system_chat(&text));
+            return true;
+        }
+        if self.game.lan.is_some() {
+            return self.game.native_tell(uuid.0, text);
+        }
+        STATE.with(|s| s.borrow_mut().tells.push((uuid, message.to_owned())));
+        true
+    }
+    fn broadcast(&mut self, message: &str) -> usize {
+        let n = self.players().len();
+        if self.game.lan.is_some() {
+            self.game.native_broadcast(Text::legacy(message));
+        } else {
+            STATE.with(|s| s.borrow_mut().broadcasts.push(message.to_owned()));
+        }
+        n
+    }
+    fn action_bar(&mut self, uuid: Uuid, message: &str) -> bool {
+        self.game.native_action_bar(uuid.0, Text::legacy(message))
+    }
+    fn day_time(&self) -> Option<i64> {
+        Some(self.game.world.day_time)
+    }
+    fn set_note_blocks_inert(&mut self, inert: bool) {
+        horizon_world::level::INERT_NOTE_BLOCKS.store(inert, std::sync::atomic::Ordering::Relaxed);
+    }
+    fn resource_pack(&mut self, uuid: Uuid, pack: &ResourcePack) -> bool {
+        let push = horizon_protocol::packets::configuration::ResourcePackPush {
+            id: pack.id.0,
+            url: pack.url.clone(),
+            hash: pack.sha1.to_ascii_lowercase(),
+            required: pack.required,
+            prompt: pack
+                .prompt
+                .as_ref()
+                .map(|p| component_nbt(&Text::legacy(p).component())),
+        };
+        self.game.plugins_send_to(uuid.0, C::ResourcePackPush(push))
+    }
+    fn can_run_commands(&self) -> bool {
+        self.game.lan_acting.is_none() && self.game.lan.is_some()
+    }
+    fn console_command(&mut self, line: &str) -> bool {
+        // Between levels' ticks the level in place is whichever ticked last,
+        // and `execute in` doesn't swap levels for the blocks it changes:
+        // put the command's level (the overworld when it names none) in
+        // place for it, then the one that was.
+        let target = line
+            .strip_prefix("execute in ")
+            .and_then(|rest| rest.split_whitespace().next())
+            .map_or(Dim::Overworld, Dim::from_id);
+        let back = self.game.dim;
+        if target != back && self.game.enter_level(None, target).is_err() {
+            return false;
+        }
+        let ok = self.game.native_run_command(line);
+        if self.game.dim != back {
+            let _ = self.game.enter_level(None, back);
+        }
+        ok
+    }
+    fn block(&self, pos: &BlockPos) -> Option<Block> {
+        let at = [pos.x, pos.y, pos.z];
+        if let Some(context) = STATE.with(|s| s.borrow().context) {
+            let b = self
+                .game
+                .native_server_block(&context, &pos.world, at)
+                .ok()?;
+            return Some(Block {
+                pos: pos.clone(),
+                kind: b.name,
+                properties: b.properties.into_iter().collect(),
+            });
+        }
+        // Inside a player's action: the level they are in.
+        if pos.world != self.game.dim.id() {
+            return None;
+        }
+        let state = self.game.world.block(at[0], at[1], at[2]);
+        let properties = self
+            .game
+            .pack
+            .assets
+            .registry
+            .state(state)
+            .map(|s| {
+                s.properties
+                    .iter()
+                    .map(|(k, v)| (k.clone(), v.clone()))
+                    .collect()
+            })
+            .unwrap_or_default();
+        Some(Block {
+            pos: pos.clone(),
+            kind: self.game.native_block(at),
+            properties,
+        })
+    }
+    fn held_item(&self) -> Option<ItemStack> {
+        let s = self.game.inventory.get(self.game.selected)?.as_ref()?;
+        Some(stack_of(s))
+    }
+    fn count_items(&mut self, item: &str) -> u32 {
+        self.game.native_count_items(item)
+    }
+    fn take_items(&mut self, item: &str, count: u32) -> u32 {
+        self.game.native_take_items(item, count)
+    }
+    fn give_items(&mut self, item: &str, count: u32) -> u32 {
+        self.game.native_give_items(item, count)
+    }
+    fn inventory(&self, uuid: Uuid) -> Option<Vec<Option<ItemStack>>> {
+        let stacks = self.game.native_player_stacks(uuid.0)?;
+        Some(stacks.iter().map(|s| s.as_ref().map(stack_of)).collect())
+    }
+    fn open_menu(&mut self, uuid: Uuid, menu: &Menu) -> Option<i32> {
+        let items = menu
+            .items
+            .iter()
+            .map(|i| i.as_ref().map(game_stack))
+            .collect();
+        // A title that is a JSON text component is sent as it is: plugins
+        // draw GUI backgrounds with a resource pack's font this way.
+        let json = menu.title.trim_start();
+        if json.starts_with('{') || json.starts_with('[') {
+            if let Ok(title) = serde_json::from_str::<serde_json::Value>(json) {
+                return self
+                    .game
+                    .native_open_menu_component(uuid.0, menu.rows, &title, items);
+            }
+        }
+        self.game
+            .native_open_menu(uuid.0, menu.rows, Text::legacy(&menu.title), items)
+    }
+    fn set_menu_items(&mut self, uuid: Uuid, items: &[Option<ItemStack>]) {
+        let items = items.iter().map(|i| i.as_ref().map(game_stack)).collect();
+        self.game.native_set_menu_items(uuid.0, items);
+    }
+    fn close_menu(&mut self, uuid: Uuid) {
+        self.game.native_close_menu(uuid.0);
+    }
+    fn log(&mut self, level: &str, line: &str) {
+        super::dedicated::log(level, line);
+    }
+}
+
+/// Plugins reached from a level's own rules (fluids, fire, pistons), where
+/// the game itself is out of reach: lines wait for the next tick.
+struct Detached;
+
